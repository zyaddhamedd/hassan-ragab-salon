# ==============================================================================
# HASSAN RAGAB SALON — BACKEND SERVICE ENVIRONMENT (RAILWAY)
# ==============================================================================
# In Railway: add these variables in your Backend Service -> Variables tab.

# 1. DATABASE CONNECTION
# Reference the PostgreSQL plugin service directly in Railway:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 2. APPLICATION SECURITY SECRETS
# Generate cryptographically secure keys with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_string
JWT_SECRET_KEY=replace_with_64_character_hex_string
FLASK_ENV=production

# 3. DOMAIN & CORS CONFIGURATION
# Provide your frontend's public HTTPS URL (e.g. https://salon.up.railway.app or custom domain)
# Setting FRONTEND_URL automatically configures CORS, MINI_TRUSTED_ORIGINS, and MINI_EXTERNAL_API_BASE_URL.
FRONTEND_URL=https://hassan-ragab-frontend.up.railway.app

# Optional manual overrides (comma-separated origins without trailing slash):
# CORS_ALLOWED_ORIGINS=https://hassan-ragab-frontend.up.railway.app
# MINI_TRUSTED_ORIGINS=https://hassan-ragab-frontend.up.railway.app
# MINI_EXTERNAL_API_BASE_URL=https://hassan-ragab-frontend.up.railway.app

# 4. INITIAL FIRST-TIME BOOTSTRAP (Required for first deployment)
# These credentials will be used on first run to create the initial operating branch and SUPER_ADMIN.
# Once created, these variables can remain or be removed (bootstrap is strictly idempotent).
INITIAL_ADMIN_EMAIL=admin@hassanragab.com
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password
INITIAL_ADMIN_NAME=Hassan Ragab Administrator
INITIAL_BRANCH_NAME=Hassan Ragab Salon
INITIAL_BRANCH_CITY=Giza

# 5. CASHIER DEVICE SECURITY POLICY
# Set to 'true' during the first week so new cashier tablets/laptops can onboard smoothly.
# Once all cashier devices complete pairing, toggle to 'false' for strict cryptographic enforcement.
MINI_LEGACY_DEVICE_COMPATIBILITY_ENABLED=true
MINI_PROOF_ENROLLMENT_REQUIRED=true

# 6. GUNICORN PROCESS CONCURRENCY
GUNICORN_WORKERS=2

# 7. PERSISTENT STORAGE
# If using a Railway Volume mounted at /app/uploads:
UPLOAD_FOLDER=/app/uploads

# Alternatively, if using Cloudinary for media storage:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
