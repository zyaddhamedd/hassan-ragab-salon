# ==============================================================================
# HASSAN RAGAB SALON — FRONTEND SERVICE ENVIRONMENT (RAILWAY)
# ==============================================================================
# In Railway: add these variables in your Frontend Service -> Variables tab.

# Node environment
NODE_ENV=production

# Private internal networking link to the Backend service.
# Use Railway's variable reference syntax to link to your backend service:
BACKEND_URL=http://${{hassan-ragab-backend.RAILWAY_PRIVATE_DOMAIN}}:${{hassan-ragab-backend.PORT}}

# (Note: PORT is automatically injected by Railway — do not manually define it)
